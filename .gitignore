# Dependencies
node_modules/

# Build output
dist/

# Environment files (contain API keys)
.env
.env.local
.env.*.local
scripts/.env

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
._*
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temp files
*.zip
*.bak

# Supabase CLI cache (auto-regenerating)
cary/supabase/.temp/

# Python
__pycache__/
*.pyc
.venv/

# Large reference assets (not needed for build) — hi-res leaf/bark scan sources.
# The wired, downscaled packs live under public/textures/ (tracked); these are the
# full-res originals kept locally for re-baking higher-res atlases.
assets/botanical-reference-hires/
assets/leaf-packs-2026/
models/
public/models/
# Allow the victorian lamp model (needed at runtime)
!public/models/lamp-posts/
!public/models/lamp-posts/victorian-lamp.glb
public/photos/lafayette-square/

# Raw data cache (regenerable via scripts/)
scripts/raw/*
# stl_parcels.json moved to cartograph/data/lafayette-square/raw/ (scene-homed)
!scripts/raw/osm_street_lamps.json

# Archived/defunct scripts
_archive/
# ...but the doc Diaries are tracked (cooled active docs, not defunct scripts).
!arborist/_archive/
!arborist/_archive/**
# Landscape intake — the operator's uploaded 3D set-pieces (DEM meshes, GLBs).
# LOCAL-ONLY by design: the landscape is a STAGE intake the operator uploads
# per-Look, deliberately OUT of the pour path so it can never be auto-swept into
# a slab (a20619cc — a stray sangabriel.obj in data/<scene>/ once baked the San
# Gabriels into Altadena). Baking is gated on an explicit design.landscape.source.
# Untracked was always the intent; this makes it so instead of leaving 34MB
# sitting in `git status` waiting for someone's `git add -A`.
cartograph/_landscape-intake/

# Cartograph generated output (per-scene data layout: cartograph/data/<scene>/).
# LS scene: most files are local-only (regenerated by the pipeline); only
# the OSM-fetched inputs and the bundled map.json are committed.
# Toy scene: fully committed — toy is a shipped fixture, not workspace state.
cartograph/data/*
!cartograph/data/lafayette-square/
!cartograph/data/toy/
!cartograph/data/hipointe-demun/
cartograph/data/hipointe-demun/*
!cartograph/data/hipointe-demun/neighborhood_boundary.json
!cartograph/data/hipointe-demun/geography.json
!cartograph/data/hipointe-demun/building-overrides.json
# content/ — track only the hand-authored content files, keep bulk out
!cartograph/data/hipointe-demun/content/
cartograph/data/hipointe-demun/content/*
!cartograph/data/hipointe-demun/content/roster.json
!cartograph/data/hipointe-demun/content/listings.json
!cartograph/data/hipointe-demun/content/nr-inventory.json
!cartograph/data/hipointe-demun/content/county-land-use-codes.csv
# override sidecars — the hand-authored SSOT bake-content applies over the
# raw join and never clobbers (reproducible source, like building-overrides).
!cartograph/data/hipointe-demun/content/listings.overrides.json
!cartograph/data/hipointe-demun/content/roster.overrides.json
!cartograph/data/hipointe-demun/raw/
!cartograph/data/hipointe-demun/clean/
cartograph/data/hipointe-demun/raw/*
!cartograph/data/hipointe-demun/raw/osm.json
!cartograph/data/hipointe-demun/raw/admin_boundaries.json
cartograph/data/hipointe-demun/clean/*
cartograph/data/lafayette-square/*
!cartograph/data/lafayette-square/neighborhood_boundary.json
!cartograph/data/lafayette-square/geography.json
!cartograph/data/lafayette-square/buildings.json
# LS's hand-tuned species routing (park species name → roster id). Authored, not
# a reproducible fetch, so it stays tracked (unlike scripts/15's derived rewrite).
!cartograph/data/lafayette-square/tree-species-map.json
!cartograph/data/lafayette-square/raw/
!cartograph/data/lafayette-square/clean/
cartograph/data/lafayette-square/raw/*
!cartograph/data/lafayette-square/raw/osm.json
!cartograph/data/lafayette-square/raw/survey.json
!cartograph/data/lafayette-square/raw/elevation.json
cartograph/data/lafayette-square/clean/*
!cartograph/data/lafayette-square/clean/map.json
!cartograph/data/lafayette-square/clean/park-polygon.json
# The authored PARK CENSUS well — City Forestry clipped to the park polygon, the
# hand-curated gem (source:'park'). Authored source (its raw maps6 export is NOT
# committed), so unlike the fetched clean/* wells it must stay tracked. Kept as an
# authored reference; the whole-hood City inventory (park_trees.json) subsumes it
# (750/756 overlap), so LS bakes City + OSM, not this.
!cartograph/data/lafayette-square/clean/park_census.json
# The REAL LS census wells that the slab is baked from. TRACKED (not the usual
# gitignored-clean/ treatment) so the recovered census can't be lost on a clean
# checkout or drift on re-fetch — the fix for the 756-vs-6,866 regression
# (scratch/CENSUS-RECOVERY-FINDINGS.md). Re-fetchable via scripts/13 (City maps9)
# + scripts/14 (OSM Overpass), but frozen here so the committed bake is reproducible.
!cartograph/data/lafayette-square/clean/park_trees.json
!cartograph/data/lafayette-square/clean/osm_trees.json
cartograph/node_modules/

# Claude Code local settings
.claude/

# ribbons.json snapshot backups created by the pipeline scripts.
# Useful locally for rollback; never wanted in source control.
src/data/ribbons.json.backup-*

# FOR-species20K LiDAR dataset (~51 GB, used as input to the Arborist
# tree-baking pipeline). Lives locally; never committed.
# Source: https://zenodo.org/records/13255198
botanica/

# Arborist operator state + caches. Curated picks live in arborist/state/;
# .laz → .ply preview conversion cache lives in arborist/_cache/. Both
# regenerable; never committed.
arborist/state/
# EXCEPT the hand-encoded species priors files — load-bearing artifacts
# per Project: Li'l Vera Cycle 1 rev. 2 (2026-05-20). Future species
# onboarding follows the same hand-encode → run → refine cycle.
!arborist/state/
!arborist/state/*/
arborist/state/*/*
!arborist/state/*/botanical-priors.json
arborist/_cache/
arborist/.venv/

# Arborist raw-GLB library. Authoring-only source pool the Arborist
# reads from; never read by runtime. The published artifact runtime
# consumes is the per-Look bake at public/baked/<look>/, written by
# arborist/bake-look.js. Library is multi-GB and regenerable; never
# commit it. See ARCHITECTURE.md §1 for the publish-loop rule.
public/trees/
