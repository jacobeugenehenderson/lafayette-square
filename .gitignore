!cartograph/data/ksi-y-m-yn/clean/
cartograph/data/ksi-y-m-yn/raw/*
!cartograph/data/ksi-y-m-yn/raw/osm.json
!cartograph/data/ksi-y-m-yn/raw/osm_street_lamps.json
# heavy GENERATED geometry — pipeline reproduces from source (park_trees census stays tracked)
cartograph/data/ksi-y-m-yn/clean/map.json
cartograph/data/ksi-y-m-yn/clean/skeleton.json
cartograph/data/ksi-y-m-yn/clean/ribbons.json
